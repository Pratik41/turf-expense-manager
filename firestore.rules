rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - users can only read their own document, admins can read all
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin(request.auth.uid);
      allow create: if request.auth.uid == resource.data.email; // Only on signup
      allow write: if isAdmin(request.auth.uid); // Only admins can modify roles
    }

    // Members collection - users can read all members, admins can modify
    match /members/{document=**} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin(request.auth.uid);
    }

    // Sessions collection - users can read, admins can create/modify
    match /sessions/{document=**} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin(request.auth.uid);
    }

    // Attendance collection - users can read, admins can modify
    match /attendance/{document=**} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin(request.auth.uid);
    }

    // LedgerEntries collection - users can read their own entries, admins can create all
    match /ledgerEntries/{document=**} {
      allow read: if request.auth != null && (isAdmin(request.auth.uid) || request.auth.uid == getUserId(resource.data.memberId));
      allow create, update: if isAdmin(request.auth.uid);
    }

    // Helper functions
    function isAdmin(uid) {
      return exists(/databases/{database}/documents/users/{uid}) &&
             get(/databases/{database}/documents/users/{uid}).data.role == 'admin';
    }

    function getUserId(memberId) {
      return get(/databases/{database}/documents/members/{memberId}).data.uid;
    }
  }
}
